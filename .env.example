# Copia este archivo a `.env.local` y rellena los dos valores para trabajar
# contra el servidor también en local. Sin él, la app funciona igual pero
# guardando todo en el navegador (ver CONECTAR-SUPABASE.md).
#
# Los dos salen de Supabase → Project Settings → API Keys.
# La clave `anon` es pública a propósito; la `service_role` NUNCA va aquí.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Quién puede tener cuenta de nutricionista. Sin esto, cualquiera que abriera
# la app podría montarse su propia consulta dentro. Varios se separan por comas.
VITE_NUTRI_EMAIL=tatianavillegas.se@gmail.com
